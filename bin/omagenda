#!/usr/bin/env python3
"""Omagenda CLI entry point.

Resolves the omagenda/ package next to this script (so the plugin runs
in place without installation) and dispatches subcommands: agenda, next,
parse, add, calendars, set, account, sync, index, watch, doctor. See
ARCHITECTURE.md §1 and PLAN.md §6.4.

Every command accepts --json for machine output and exits non-zero with a
one-line message on stderr on failure.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import date, datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))


def _local_reference() -> datetime:
    """`datetime.now()` in a real named IANA zone, not a bare UTC-offset
    tzinfo -- `.astimezone()` alone gives the latter, which has no `.key`
    for the parser's "local zone" default to read."""
    try:
        target = Path("/etc/localtime").resolve()
        name = str(target.relative_to("/usr/share/zoneinfo"))
        return datetime.now(ZoneInfo(name))
    except (OSError, ValueError):
        return datetime.now().astimezone()

NOT_YET_IMPLEMENTED: dict[str, str] = {}


def _fail(message: str) -> int:
    print(f"omagenda: {message}", file=sys.stderr)
    return 1


def _fmt_event_line(event: dict) -> str:
    if event["allDay"]:
        when = event["start"]
    else:
        start_time = event["start"][11:16]
        end_time = event["end"][11:16] if event["end"][:10] == event["start"][:10] else event["end"]
        when = f"{event['start'][:10]} {start_time}–{end_time}"
    bits = [when, event["title"]]
    if event["location"]:
        bits.append(f"@ {event['location']}")
    return "  ".join(bits)


def cmd_index(args) -> int:
    from omagenda.index import index

    path = index(days=args.days)
    if args.json:
        print(json.dumps({"path": str(path)}))
    else:
        print(f"Wrote {path}")
    return 0


def cmd_agenda(args) -> int:
    from omagenda.index import build_agenda

    start = date.fromisoformat(args.date_from) if args.date_from else date.today()
    agenda = build_agenda(days=args.days, start=start, active_set=args.calendar_set)
    if args.json:
        print(json.dumps(agenda))
        return 0
    if not agenda["events"]:
        print("Nothing on the agenda.")
        return 0
    for event in agenda["events"]:
        print(_fmt_event_line(event))
    return 0


def _build_ics(result: dict):
    import icalendar
    import uuid
    from datetime import date as date_cls, datetime as dt_cls
    from zoneinfo import ZoneInfo

    cal = icalendar.Calendar()
    cal.add("prodid", "-//Omagenda//EN")
    cal.add("version", "2.0")

    event = icalendar.Event()
    uid = f"{uuid.uuid4()}@omagenda"
    event.add("uid", uid)
    event.add("summary", result["title"] or "Untitled")
    now = dt_cls.now().astimezone()
    event.add("dtstamp", now)
    event.add("created", now)
    event.add("sequence", 0)
    if result["location"]:
        event.add("location", result["location"])

    if result["allDay"]:
        start = date_cls.fromisoformat(result["start"])
        end = date_cls.fromisoformat(result.get("end") or result["start"])
        if end <= start:
            end = start + timedelta(days=1)
        event.add("dtstart", start)
        event.add("dtend", end)
    else:
        tz = ZoneInfo(result["tz"]) if result["tz"] else None
        start = dt_cls.fromisoformat(result["start"])
        end = dt_cls.fromisoformat(result["end"])
        if tz:
            start, end = start.replace(tzinfo=tz), end.replace(tzinfo=tz)
        event.add("dtstart", start)
        event.add("dtend", end)

    if result["rrule"]:
        parts = dict(p.split("=", 1) for p in result["rrule"].split(";"))
        event.add("rrule", parts)

    for alarm in result["alarms"]:
        valarm = icalendar.Alarm()
        valarm.add("action", "DISPLAY")
        valarm.add("description", result["title"] or "Reminder")
        from omagenda.alarms import parse_trigger
        valarm.add("trigger", parse_trigger(alarm))
        event.add_component(valarm)

    cal.add_component(event)
    return cal, uid


def cmd_calendars(args) -> int:
    from omagenda.accounts import write_config
    from omagenda.vdir import discover_calendars
    from omagenda.doctor import read_config

    calendars = discover_calendars()
    config = read_config()

    if args.clear_default:
        config.pop("default_calendar", None)
        write_config(config)
        print("Cleared the default calendar. New events go to the first writable calendar.")
        return 0

    if args.set_default:
        target = next((c for c in calendars if c["id"] == args.set_default), None)
        if target is None:
            names = ", ".join(c["id"] for c in calendars) or "none"
            return _fail(f"no calendar named '{args.set_default}' (have: {names})")
        if target["readOnly"]:
            return _fail(f"'{args.set_default}' is read-only, so new events can't go there")
        config["default_calendar"] = target["id"]
        write_config(config)
        print(f"New events now go to '{target['id']}' unless a sentence says otherwise.")
        return 0

    if args.json:
        print(json.dumps({"calendars": calendars, "defaultCalendar": config.get("default_calendar")}))
        return 0
    if not calendars:
        print("No calendars found. Create one under ~/.local/share/calendars/<name>/.")
        return 0

    default = config.get("default_calendar")
    writable = [c for c in calendars if not c["readOnly"]]
    for cal in calendars:
        marker = " (default)" if cal["id"] == default else ""
        ro = " [read-only]" if cal["readOnly"] else ""
        print(f"{cal['id']:20s} {cal['name']:20s} {cal['color']}{ro}{marker}")

    # Silently picking one of several writable calendars is exactly the
    # kind of thing a user only discovers after an event lands somewhere
    # unexpected, so say which one it would be and how to change it.
    if not default and writable:
        print()
        if len(writable) == 1:
            print(f"New events go to '{writable[0]['id']}' (the only writable calendar).")
        else:
            print(f"No default set, so new events go to '{writable[0]['id']}'.")
            print(f"Change it with: omagenda calendars --set-default <id>")
    return 0


def cmd_add(args) -> int:
    from omagenda.parse import parse_event
    from omagenda.vdir import discover_calendars, write_event_ics
    from omagenda.doctor import read_config
    from omagenda.index import index as reindex

    reference = _local_reference()
    calendars = discover_calendars()
    if not calendars:
        return _fail("no calendars found under the vdir; create one under ~/.local/share/calendars/<name>/ first")
    known = [c["id"] for c in calendars]
    result = parse_event(args.sentence, reference=reference, known_calendars=known)

    writable = [c for c in calendars if not c["readOnly"]]
    # The fallback has to be a calendar that can actually be written to.
    # Picking calendars[0] chose whatever sorted first, which on a real
    # setup was a read-only Google subscription -- so every Quick Add
    # failed with "'gcal' is read-only" while a perfectly good local
    # calendar sat right there.
    configured_default = read_config().get("default_calendar")
    # A default that has since been removed or turned read-only shouldn't
    # wedge Quick Add; fall through to a calendar that can take the event.
    if configured_default and not any(c["id"] == configured_default and not c["readOnly"] for c in calendars):
        configured_default = None
    target_id = (args.calendar or result["calendar"] or configured_default
                 or (writable[0]["id"] if writable else None))
    if target_id is None:
        return _fail("no writable calendar; every calendar found is read-only")
    target = next((c for c in calendars if c["id"] == target_id), None)
    if target is None:
        return _fail(f"no calendar named '{target_id}' (have: {', '.join(known)})")
    if target["readOnly"]:
        writable_names = ", ".join(c["id"] for c in writable) or "none"
        return _fail(f"'{target_id}' is read-only (writable: {writable_names})")

    cal, uid = _build_ics(result)

    if args.dry_run:
        payload = {"wouldWrite": True, "calendar": target["id"], "uid": uid, "event": result}
        if args.json:
            print(json.dumps(payload))
        else:
            when = result["start"] if result["allDay"] else f"{result['start']}-{result['end'][11:]}"
            print(f"Would add '{result['title']}' to {target['id']}: {when} (dry run, not written)")
        return 0

    path = write_event_ics(target["path"], cal, uid=uid)
    reindex()
    if args.json:
        print(json.dumps({"file": str(path), "calendar": target["id"], "event": result}))
    else:
        print(f"Added '{result['title']}' to {target['id']} ({path.name})")
    if not args.json:
        for warning in result["warnings"]:
            print(f"  ! {warning}")
    return 0


def cmd_set(args) -> int:
    from omagenda.index import index
    from omagenda.sets import defined_sets, read_active, write_active

    sets = defined_sets()
    name = args.name
    if args.number is not None:
        if not 1 <= args.number <= min(9, len(sets)):
            return _fail("no calendar set at that number")
        name = list(sets)[args.number - 1]
    if name is not None and (not name or name not in sets):
        return _fail("unknown calendar set: " + repr(name))
    if name is not None or args.clear:
        write_active("" if args.clear else name)
        index()
    result = {"activeSet": read_active(), "sets": sets}
    if args.json:
        print(json.dumps(result))
    else:
        print("Active set: " + (result["activeSet"] or "all"))
        for number, (set_name, calendars) in enumerate(sets.items(), 1):
            print(f"{number}. {set_name}: {', '.join(calendars) or 'all'}")
    return 0


def cmd_doctor(args) -> int:
    from omagenda.doctor import run

    report = run()
    if args.json:
        print(json.dumps(report))
        return 0
    all_ok = True
    for name, check in report.items():
        marker = "ok" if check["ok"] else "!!"
        all_ok = all_ok and check["ok"]
        print(f"[{marker}] {name}: {check['detail']}")
    return 0 if all_ok else 1


def _acquire_watch_lock():
    """A single `watch` instance at a time, released automatically if the
    process dies (flock, not a PID file, so a crash never leaves a stale
    lock behind)."""
    import fcntl

    from omagenda.index import resolve_state_dir

    state_dir = resolve_state_dir()
    state_dir.mkdir(parents=True, exist_ok=True)
    lock_path = state_dir / "watch.lock"
    lock_file = open(lock_path, "w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock_file.close()
        return None
    lock_file.write(str(os.getpid()))
    lock_file.flush()
    return lock_file


def _wait_for_vdir_change(vdir_root, poll_seconds: int = 15) -> bool:
    """Block until the vdir changes, or `poll_seconds` pass. Returns True
    if a change was actually seen. Prefers inotifywait (inotify-tools);
    falls back to plain polling when it's missing, per AGENTS.md's Phase
    1 brief -- that fallback can't tell the two apart, so it reports no
    change and leaves the periodic sync to carry the load."""
    import shutil
    import time

    inotifywait = shutil.which("inotifywait")
    if inotifywait:
        result = subprocess.run(
            # close_write, not modify: a plain metadata touch or an
            # in-progress write triggers neither MODIFY reliably nor what
            # we actually want, which is "a file finished being written".
            # Matches the event set Omarchy's own plugin-reload watcher
            # uses (ps shows it live: inotifywait -e close_write,create,
            # delete,move on ~/.config/omarchy/plugins).
            [inotifywait, "-r", "-q", "-t", str(poll_seconds),
             "-e", "close_write,create,delete,move", str(vdir_root)],
            capture_output=True,
        )
        # inotifywait exits 2 on timeout, 0 when it saw something. The
        # difference is what separates "the user just added an event,
        # push it" from "nothing happened, this is just the heartbeat".
        return result.returncode == 0
    time.sleep(poll_seconds)
    return False


def _source_paths() -> list[Path]:
    """This script plus every module of the package it actually imported.

    Resolved through the loaded package rather than guessed from a path,
    so it stays correct however the CLI was reached -- the plugin folder
    and ~/.local/bin/omagenda are both symlinks into the repo.
    """
    import omagenda

    paths = [Path(__file__).resolve()]
    paths += sorted(Path(omagenda.__file__).resolve().parent.rglob("*.py"))
    return paths


def _source_fingerprint() -> tuple:
    out = []
    for path in _source_paths():
        try:
            stat = path.stat()
            out.append((str(path), stat.st_mtime_ns, stat.st_size))
        except OSError:
            out.append((str(path), 0, 0))  # a file mid-update counts as changed
    return tuple(out)


DEFAULT_SYNC_INTERVAL = 300
SYNC_SETTLE = 10


def _sync_due(now: float, last_sync: float, pending_push: bool,
              interval: int, settle: int = SYNC_SETTLE) -> bool:
    """Whether the watcher should sync on this pass.

    Two reasons to: the periodic pull has come round, or the user changed
    something locally and the settle window has passed. The settle window
    exists because a sync writes into the vdir it is watching, so its own
    writes arrive as changes -- without it, one sync schedules the next
    and the watcher spins forever.
    """
    since = now - last_sync
    return since >= interval or (pending_push and since >= settle)


def _sync_once() -> None:
    """One sync attempt from inside the watcher. Never raises: the
    watcher outlives any single network failure. Failures do go to
    stderr, which the service collects and the panel shows -- an event
    that isn't reaching the server is exactly what the user needs told."""
    from omagenda.sync import sync_all

    try:
        results = sync_all()
    except Exception as exc:  # noqa: BLE001 -- a watcher must not die of this
        print(f"omagenda watch: sync failed, will retry: {exc}", file=sys.stderr)
        return
    broken = {k: v for k, v in results.items() if not v.get("ok", False)}
    for account_id, result in sorted(broken.items()):
        print(f"omagenda watch: sync failed for '{account_id}': "
              f"{result.get('detail', 'unknown error')}", file=sys.stderr)


def cmd_watch(args) -> int:
    import time

    from omagenda.alarms import check_and_fire
    from omagenda.doctor import read_config
    from omagenda.index import build_agenda, write_agenda
    from omagenda.vdir import resolve_vdir_root

    lock = _acquire_watch_lock()
    if lock is None:
        return _fail("another 'omagenda watch' is already running")

    vdir_root = resolve_vdir_root()

    # PLAN.md § "The vdir is still the truth": sync is run by `omagenda
    # sync` *and by `omagenda watch` on a timer*. Only the reindex half
    # was ever built, so an event added in Quick Add reached the panel
    # instantly and the server never -- it sat in the vdir until someone
    # happened to run `omagenda sync` by hand.
    config = read_config()
    has_accounts = bool(config.get("accounts"))
    sync_interval = args.sync_interval if args.sync_interval is not None else int(
        config.get("sync_interval", DEFAULT_SYNC_INTERVAL))
    syncing = has_accounts and sync_interval > 0 and not args.no_sync
    last_sync = 0.0
    pending_push = False

    if syncing:
        print(f"omagenda watch: watching {vdir_root}, syncing every "
              f"{sync_interval}s", file=sys.stderr)
    else:
        print(f"omagenda watch: watching {vdir_root} (no sync: "
              f"{'disabled' if has_accounts else 'no accounts configured'})",
              file=sys.stderr)

    # Quickshell adopts long-running Process objects across a config
    # reload -- deliberately, so reloading your shell doesn't kill the
    # commands it is running. The consequence for a plugin is that
    # updating its code leaves the *old* watcher running the *old* code,
    # indefinitely, with nothing to suggest anything is wrong. Python has
    # already imported these modules, so this process can never pick the
    # new code up; the only correct move is to stand down and let the
    # service's restart timer start a replacement that will.
    fingerprint = _source_fingerprint()

    try:
        while True:
            if _source_fingerprint() != fingerprint:
                print("omagenda watch: plugin code changed on disk, exiting so "
                      "the shell restarts me with it", file=sys.stderr)
                return 0

            # A single malformed .ics file (a half-finished sync write, a
            # hand-edit gone wrong) must never take the whole long-running
            # watcher down with it -- log it and keep watching, so the
            # user's next fix or the next sync gets picked up normally.
            try:
                agenda = build_agenda(vdir_root, days=args.days)
                write_agenda(agenda)
                check_and_fire(agenda)
            except Exception as exc:  # noqa: BLE001 -- see comment above
                print(f"omagenda watch: reindex failed, will retry: {exc}", file=sys.stderr)

            if syncing:
                if _sync_due(time.monotonic(), last_sync, pending_push, sync_interval):
                    pending_push = False
                    _sync_once()
                    # Timed from after the sync, so a slow one doesn't
                    # immediately qualify as due again.
                    last_sync = time.monotonic()

            changed = _wait_for_vdir_change(vdir_root, poll_seconds=args.poll_seconds)
            if changed:
                pending_push = True
    except KeyboardInterrupt:
        return 0


def _default_account_id(account_type: str, email: str | None, username: str | None) -> str:
    """`--id` is only a local label, so requiring it for the common case is
    friction for nothing. An address gives it a name worth having; without
    one the type alone will do."""
    from omagenda.accounts import list_accounts

    handle = (email or username or "").split("@")[0].strip()
    handle = re.sub(r"[^A-Za-z0-9_-]", "-", handle)
    base = f"{account_type}-{handle}" if handle else account_type

    taken = {a["id"] for a in list_accounts()}
    if base not in taken:
        return base
    for n in range(2, 100):
        if f"{base}-{n}" not in taken:
            return f"{base}-{n}"
    return base


def cmd_account_add(args) -> int:
    from omagenda.accounts import add_account, generate_pimsync_config, store_secret

    account_id = args.id or _default_account_id(args.account_type, args.email, args.username)
    account: dict = {"id": account_id, "type": args.account_type}

    if args.account_type == "google":
        from omagenda.bridges.google import authorize, list_calendars

        if args.email:
            account["email"] = args.email
        # Authorize BEFORE persisting. Saving first left a broken account
        # behind whenever consent failed -- which it does every time on an
        # account enrolled in Advanced Protection -- and every later
        # `omagenda sync` then reported an error for an account that had
        # never worked and could not be retried without removing it first.
        print(f"Adding '{account_id}'. Opening your browser to sign in to Google...")
        authorize(account)
        add_account(account)
        calendars = list_calendars(account)
        print(f"Connected. {len(calendars)} calendar(s) available:")
        for cal in calendars:
            print(f"  {cal.id}  {cal.name}{'' if cal.writable else '  [read-only]'}")
        print("All writable calendars will sync. Add 'calendars = [...]' in "
              "~/.config/omagenda/config.toml to sync only specific ones.")

    elif args.account_type == "icloud":
        import getpass

        if not args.username:
            return _fail("icloud accounts need --username")
        account["username"] = args.username
        account["sync"] = "pimsync"
        password = getpass.getpass("App-specific password (from appleid.apple.com): ")
        add_account(account)
        store_secret(account_id, password)
        config_path = generate_pimsync_config(account)
        print(f"Wrote {config_path}. Run 'omagenda sync' to sync for the first time.")

    elif args.account_type == "caldav":
        import getpass

        if not args.url:
            return _fail("caldav accounts need --url")
        account["url"] = args.url
        if args.username:
            account["username"] = args.username
        account["sync"] = "pimsync"
        password = getpass.getpass("Password: ")
        add_account(account)
        store_secret(account_id, password)
        config_path = generate_pimsync_config(account)
        print(f"Wrote {config_path}. Run 'omagenda sync' to sync for the first time.")

    elif args.account_type == "ics":
        # A subscription URL carries its own access token -- it IS the
        # credential -- so prompting keeps it out of shell history the same
        # way the password prompts above do. --url stays for scripts.
        import getpass

        url = args.url or getpass.getpass("Secret iCal URL (input hidden): ").strip()
        if not url:
            return _fail("ics subscriptions need a URL")
        if not url.startswith(("http://", "https://", "webcal://", "file://")):
            return _fail("that doesn't look like a URL; expected one starting with https://")
        account["url"] = url.replace("webcal://", "https://", 1)
        if args.color:
            account["color"] = args.color
        add_account(account)
        print(f"Added '{account_id}'. Run 'omagenda sync' to fetch it for the first time.")

    else:
        return _fail(f"unknown account type '{args.account_type}'")

    return 0


def _mask_url(url: str) -> str:
    """A subscription URL is a credential -- it grants read access to the
    calendar to anyone holding it -- so `account list` shows enough to tell
    two of them apart and no more. --json still returns it in full for
    scripts that genuinely need it."""
    if not url:
        return ""
    import urllib.parse

    parsed = urllib.parse.urlparse(url)
    if not parsed.netloc:
        return "(hidden)"
    return f"{parsed.scheme}://{parsed.netloc}/… (hidden)"


def cmd_account_list(args) -> int:
    from omagenda.accounts import list_accounts

    accounts = list_accounts()
    if args.json:
        print(json.dumps(accounts))
        return 0
    if not accounts:
        print("No accounts configured.")
        return 0
    for account in accounts:
        detail = account.get("email") or account.get("username") or _mask_url(account.get("url", ""))
        print(f"{account['id']:20s} {account['type']:10s} {detail}")
    return 0


def cmd_account_remove(args) -> int:
    from omagenda.accounts import remove_account

    result = remove_account(args.id)
    if result is None:
        return _fail(f"no account named '{args.id}'")
    if result["revoked"] is False:
        print("Warning: Google revocation failed; revoke access at https://myaccount.google.com/permissions", file=sys.stderr)
    if args.json:
        print(json.dumps(result))
    else:
        print(f"Removed '{args.id}'.")
    print(f"Local calendar folder retained; you may delete it: {result['calendarFolder']}",
          file=sys.stderr if args.json else sys.stdout)
    return 0


def cmd_sync(args) -> int:
    from omagenda.sync import sync_all
    from omagenda.index import index as reindex

    results = sync_all()
    reindex()
    if args.json:
        print(json.dumps(results))
        return 0
    if not results:
        print("No accounts configured (see docs/sync-setup.md).")
        return 0
    all_ok = True
    for account_id, result in results.items():
        marker = "ok" if result["ok"] else "!!"
        all_ok = all_ok and result["ok"]
        if "calendars" in result:
            print(f"[{marker}] {account_id}:")
            for cal_id, counts in result["calendars"].items():
                cal_marker = "ok" if counts.get("ok", False) else "!!"
                if "detail" in counts:
                    print(f"  [{cal_marker}] {cal_id}: {counts['detail']}")
                else:
                    summary = (f"pulled {counts['pulled']}, created {counts['createdRemote']}, "
                               f"updated {counts['updated']}, deleted {counts['deletedLocal']}"
                               + (f", {counts['conflicts']} conflict(s)" if counts["conflicts"] else ""))
                    print(f"  [{cal_marker}] {cal_id}: {summary}")
                    for error in counts.get("errors", []):
                        print(f"      ! {error}")
        else:
            print(f"[{marker}] {account_id}: {result.get('detail', '')}")

        if result.get("needsReauth"):
            # Said again, plainly, after the per-calendar noise: this is
            # the one failure that will not fix itself.
            print(f"\n  {result.get('summary', 'Sign-in expired')}.")
            print(f"  {result.get('detail', '')}\n")
    return 0 if all_ok else 1


def cmd_parse(args) -> int:
    from omagenda.parse import parse_event
    from omagenda.vdir import discover_calendars

    reference = _local_reference()
    known = [c["id"] for c in discover_calendars()]
    result = parse_event(args.sentence, reference=reference, known_calendars=known)
    result["ok"] = True
    if args.json:
        print(json.dumps(result))
        return 0
    print(f"{result['title']}")
    when = result["start"] if result["allDay"] else f"{result['start']} - {result.get('end', '')}"
    print(f"  when: {when}")
    if result["calendar"]:
        print(f"  calendar: {result['calendar']}")
    if result["location"]:
        print(f"  location: {result['location']}")
    if result["rrule"]:
        print(f"  repeats: {result['rrule']}")
    if result["alarms"]:
        print(f"  alarms: {', '.join(result['alarms'])}")
    if not args.json:
        for warning in result["warnings"]:
            print(f"  ! {warning}")
    return 0


def cmd_next(args) -> int:
    from omagenda.index import build_agenda, current_or_next_event

    agenda = build_agenda(days=7, start=date.today())
    event = current_or_next_event(agenda["events"], _local_reference())
    if args.json:
        print(json.dumps(event))
        return 0
    print(_fmt_event_line(event) if event else "Nothing upcoming.")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="omagenda")
    sub = parser.add_subparsers(dest="command", required=True)

    p_index = sub.add_parser("index", help="rebuild agenda.json from the vdir")
    p_index.add_argument("--days", type=int, default=14)
    p_index.add_argument("--json", action="store_true")
    p_index.set_defaults(func=cmd_index)

    p_agenda = sub.add_parser("agenda", help="what the panel shows")
    p_agenda.add_argument("--days", type=int, default=14)
    p_agenda.add_argument("--from", dest="date_from", default=None)
    p_agenda.add_argument("--set", dest="calendar_set", default=None)
    p_agenda.add_argument("--json", action="store_true")
    p_agenda.set_defaults(func=cmd_agenda)

    p_next = sub.add_parser("next", help="what the pill shows")
    p_next.add_argument("--json", action="store_true")
    p_next.set_defaults(func=cmd_next)

    p_parse = sub.add_parser("parse", help="parsed event, no write")
    p_parse.add_argument("sentence")
    p_parse.add_argument("--json", action="store_true")
    p_parse.set_defaults(func=cmd_parse)

    p_add = sub.add_parser("add", help="parse a sentence and write the event")
    p_add.add_argument("sentence")
    p_add.add_argument("--calendar", default=None)
    p_add.add_argument("--dry-run", action="store_true")
    p_add.add_argument("--json", action="store_true")
    p_add.set_defaults(func=cmd_add)

    p_calendars = sub.add_parser("calendars", help="vdir discovery, colors, and the default for new events")
    p_calendars.add_argument("--set-default", dest="set_default", default=None, metavar="ID",
                             help="send new events to this calendar unless a sentence says otherwise")
    p_calendars.add_argument("--clear-default", dest="clear_default", action="store_true",
                             help="go back to using the first writable calendar")
    p_calendars.add_argument("--json", action="store_true")
    p_calendars.set_defaults(func=cmd_calendars)

    p_set = sub.add_parser("set", help="list, select, or clear the active calendar set")
    selection = p_set.add_mutually_exclusive_group()
    selection.add_argument("name", nargs="?")
    selection.add_argument("--clear", action="store_true")
    selection.add_argument("--number", type=int, help="select the Nth defined set (1–9)")
    p_set.add_argument("--json", action="store_true")
    p_set.set_defaults(func=cmd_set)

    p_doctor = sub.add_parser("doctor", help="dependencies, vdir, sync tool, keyring, plugin enabled")
    p_doctor.add_argument("--json", action="store_true")
    p_doctor.set_defaults(func=cmd_doctor)

    p_sync = sub.add_parser("sync", help="runs pimsync/vdirsyncer or bridges if configured, then reindexes")
    p_sync.add_argument("--json", action="store_true")
    p_sync.set_defaults(func=cmd_sync)

    p_watch = sub.add_parser("watch", help="long-running: reindex on vdir changes, fire alarms")
    p_watch.add_argument("--days", type=int, default=14)
    p_watch.add_argument("--poll-seconds", type=int, default=15)
    p_watch.add_argument("--sync-interval", type=int, default=None,
                         help=f"seconds between syncs (default {DEFAULT_SYNC_INTERVAL}, "
                              "or 'sync_interval' in config.toml; 0 disables)")
    p_watch.add_argument("--no-sync", action="store_true",
                         help="reindex only, never sync (for debugging)")
    p_watch.set_defaults(func=cmd_watch)

    p_account = sub.add_parser("account", help="account add|list|remove")
    account_sub = p_account.add_subparsers(dest="account_action", required=True)

    p_account_add = account_sub.add_parser("add", help="add google|icloud|caldav|ics")
    p_account_add.add_argument("account_type", choices=["google", "icloud", "caldav", "ics"])
    p_account_add.add_argument("--id", default=None,
                               help="local label for this account; defaults to <type>-<handle from the address>")
    p_account_add.add_argument("--email", default=None, help="google only, for your own reference")
    p_account_add.add_argument("--username", default=None, help="icloud/caldav")
    p_account_add.add_argument("--url", default=None, help="caldav/ics")
    p_account_add.add_argument("--color", default=None, help="ics only, a theme color name")
    p_account_add.set_defaults(func=cmd_account_add)

    p_account_list = account_sub.add_parser("list", help="list configured accounts")
    p_account_list.add_argument("--json", action="store_true")
    p_account_list.set_defaults(func=cmd_account_list)

    p_account_remove = account_sub.add_parser("remove", help="remove an account")
    p_account_remove.add_argument("id")
    p_account_remove.add_argument("--json", action="store_true")
    p_account_remove.set_defaults(func=cmd_account_remove)

    for name, phase in NOT_YET_IMPLEMENTED.items():
        placeholder = sub.add_parser(name, help=f"not yet implemented ({phase})")
        placeholder.add_argument("rest", nargs=argparse.REMAINDER)
        placeholder.set_defaults(func=None, phase=phase, name=name)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    if args.func is None:
        return _fail(f"'{args.name}' is not yet implemented ({args.phase}, see AGENTS.md)")
    try:
        return args.func(args)
    except Exception as exc:  # noqa: BLE001 -- CLI boundary: report, don't traceback
        return _fail(str(exc))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
